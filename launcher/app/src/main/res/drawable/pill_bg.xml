<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback for the top-bar pills; MainActivity swaps in GlassDrawable, which adds the blur.
     Flat glass: an even veil and a light rim, with no brighter top. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF000000" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF111111" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
